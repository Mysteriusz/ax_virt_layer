CompileFlags:
  Add:
    - -xc
    - -Wall
    - -WX
    - -Wno-pragma-pack
    - -Wno-unused-function
    - -Wno-unknown-pragmas
    - -std=c23
    - -m64

    - "-IC:/msys64/ucrt64/include"
    - "-ID:/ax_project/ax_virt_layer_utils/utils/ax_utility_lib/build/WIN_UM/headers"
    - "-ID:/ax_project/ax_virt_layer/win64/type_2/src"
    - "-ID:/ax_project/ax_virt_layer/win64/type_2/src/mte"

    - "-DAX_WIN64"
    - "-DAX_UM"
Diagnostics:
  Suppress:
    - "unused-includes"
